{
  "jsonrpc": "2.0",
  "id": 1,
  "result": {
    "tools": [
      {
        "name": "search_documents",
        "description": "Search through project documentation for relevant content",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "maxLength": 200,
              "description": "Search query string"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Maximum number of results"
            }
          },
          "required": ["query"],
          "additionalProperties": false
        }
      },
      {
        "name": "read_project_file",
        "description": "Read a file within the project directory",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_/.-]*$",
              "maxLength": 256,
              "description": "Relative path within the project root"
            }
          },
          "required": ["path"],
          "additionalProperties": false
        }
      },
      {
        "name": "get_status",
        "description": "Get the current project build status",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false
        }
      }
    ]
  }
}
